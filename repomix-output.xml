        source = '''"docstring"
import sys
print(__name__, __doc__, __package__, __spec__)
print(sys.argv[1:])
class Example:
    def __init__(self, x): self.x = x
print([Example(i).x for i in range(3)])
try:
    {}["missing"]
except KeyError as error:
    print(type(error).__name__)
finally:
    print("done")
'''

import copy
import json
from pathlib import Path
import tempfile
import unittest
from unittest.mock import Mock

from aithon.agent import ToolAgent
from aithon.cli import run_script
from aithon.models import ProfileConfig, ResolvedConfig
from aithon.prompt_cache import PREFIX_KEY, chat_body, prefix_key


class PromptCacheTests(unittest.TestCase):
    def test_loop_keeps_prefix_but_reads_fresh_complete_history(self):
        captured = []
        def complete(messages, tools):
            captured.append((copy.deepcopy(messages), PREFIX_KEY.get()))
            state = json.loads(messages[2]['content'])
            history = state['frame_objects']['history']
            self.assertEqual(history['type'], 'list')
            self.assertNotIn('snapshot', history)
            self.assertNotIn('value', history)
            return {'role': 'assistant', 'tool_calls': [{'id': 'done', 'type': 'function',
                'function': {'name': 'finish', 'arguments': json.dumps({'code': 'len(history)'})}}]}
        provider = Mock(complete=Mock(side_effect=complete))
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / 'main.py'
            path.write_text('history: list[int] = []\nfor trial in range(10):\n    candidate: int = choose next candidate\n    history.append(candidate)\n')
            profile = ProfileConfig('default', 'fake', 'model')
            result = run_script(path, config=ResolvedConfig(None,path.parent,'default',{'default':profile}),
                                agent_factory=lambda _: ToolAgent(provider))
        self.assertEqual(result['history'], list(range(10)))
        self.assertEqual(provider.complete.call_count, 10)
        self.assertTrue(all(messages[:2] == captured[0][0][:2] for messages, _ in captured))
        self.assertEqual(len({key for _, key in captured}), 1)
        self.assertIsNone(PREFIX_KEY.get())

    def test_provider_hints_do_not_cache_responses_or_mutate_messages(self):
        messages = [{'role': 'system', 'content': 'instructions'},
                    {'role': 'user', 'content': 'stable'}, {'role': 'user', 'content': 'fresh'}]
        original = copy.deepcopy(messages)
        token = PREFIX_KEY.set('test-key')
        try:
            for model in ('deepseek/example', 'anthropic/example'):
                profile = ProfileConfig('default', 'openai-compatible', model, base_url='https://openrouter.ai/api/v1')
                body = chat_body(profile, messages, [])
                self.assertEqual(body['session_id'], 'aithon-test-key')
                self.assertEqual(body['messages'][2], original[2])
                if model.startswith('anthropic/'):
                    self.assertEqual(body['messages'][1]['content'][0]['cache_control'], {'type':'ephemeral'})
                else:
                    self.assertEqual(body['messages'], original)
            custom = ProfileConfig('default', 'openai-compatible', 'model', base_url='https://custom.test/v1')
            self.assertNotIn('session_id', chat_body(custom, messages, []))
        finally:
            PREFIX_KEY.reset(token)
        self.assertEqual(messages, original)

    def test_prefix_key_changes_with_project_context_and_tools(self):
        baseline = prefix_key('/a', 'default', ['source'], ['tools'])
        for args in (('/b', 'default', ['source'], ['tools']),
                     ('/a', 'default', ['changed source'], ['tools']),
                     ('/a', 'default', ['source'], ['changed tools']),
                     ('/a', 'other', ['source'], ['tools'])):
            self.assertNotEqual(baseline, prefix_key(*args))

"""Provider hints for reusable prompt prefixes; never cache AI responses."""
from contextvars import ContextVar
import hashlib
import json
from urllib.parse import urlsplit

PREFIX_KEY = ContextVar('aithon_prompt_prefix', default=None)


def canonical(value):
    return json.dumps(value, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(',', ':'))


def prefix_key(project, profile, messages, tools):
    return hashlib.sha256(canonical([str(project), profile, messages, tools]).encode()).hexdigest()


def chat_body(profile, messages, tools):
    body = {'model': profile.model, 'messages': messages, 'tools': tools,
            'tool_choice': profile.tool_choice if tools else 'auto', 'stream': False}
    key = PREFIX_KEY.get()
    if key and urlsplit(profile.base_url).hostname == 'openrouter.ai':
        body['session_id'] = 'aithon-' + key
        # These models need explicit breakpoints. Other models use implicit caching.
        if profile.model.startswith('anthropic/') and len(messages) >= 3:
            copied = [dict(message) for message in messages]
            copied[1]['content'] = [{'type': 'text', 'text': messages[1]['content'],
                                     'cache_control': {'type': 'ephemeral'}}]
            body['messages'] = copied
    return body

"""Version 2 config normalization; v1 profiles are kept unchanged."""
from __future__ import annotations

import re
from .models import ConfigError

CAPABILITIES = frozenset(('reasoning', 'vision', 'image_generation', 'image_editing', 'embedding',
                         'semantic_search', 'reranking', 'speech_to_text', 'text_to_speech',
                         'video', 'document_understanding', 'indexing'))
PERMISSIONS = frozenset(('read_asset', 'read_code', 'network', 'generate_file', 'write_filesystem', 'execute_code'))


def normalize_v2(data):
    providers = data.get('providers', {})
    if not isinstance(providers, dict):
        raise ConfigError('providers must be a table')
    allowed = {'adapter', 'base_url', 'api_key', 'api_key_env', 'timeout'}
    for name, provider in providers.items():
        if not name or not isinstance(provider, dict) or provider.keys() - allowed:
            raise ConfigError('Invalid named provider configuration')
        if provider.get('adapter') not in ('openrouter', 'openai-compatible', 'gemini', 'local'):
            # Entry point adapters may also declare capabilities.
            if not isinstance(provider.get('adapter'), str) or not provider['adapter'].strip():
                raise ConfigError('Named provider requires adapter')
        for key in ('base_url', 'api_key', 'api_key_env'):
            if key in provider and not isinstance(provider[key], str):
                raise ConfigError(f'Provider {name!r}: {key} must be a string')
        if 'api_key_env' in provider and not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', provider['api_key_env']):
            raise ConfigError('api_key_env must name an environment variable; use api_key for a literal key')
        if 'timeout' in provider and (type(provider['timeout']) not in (int, float) or not 0 < provider['timeout'] < float('inf')):
            raise ConfigError('Provider timeout must be finite and positive')
    profiles = data.get('profiles', {})
    if not isinstance(profiles, dict):
        raise ConfigError('profiles must be a table')
    normalized = {}
    for name, original in profiles.items():
        if not isinstance(original, dict):
            raise ConfigError('Profile must be a table')
        values = dict(original)
        routes = values.get('routes', {})
        if not isinstance(routes, dict):
            raise ConfigError('routes must be a table')
        clean = {}
        for capability, entries in routes.items():
            capability = capability.replace('-', '_')
            if not re.fullmatch(r"[a-z][a-z0-9_]*", capability) or capability in clean or not isinstance(entries, list) or not entries:
                raise ConfigError('Invalid or empty capability route')
            for entry in entries:
                if not isinstance(entry, dict) or entry.keys() - {'provider', 'model', 'revision', 'modes'}:
                    raise ConfigError('Route requires provider/model and optional revision')
                if not isinstance(entry.get('provider'), str) or entry['provider'] not in providers:
                    raise ConfigError('Route names an undefined provider')
                if not isinstance(entry.get('model'), str) or not entry['model'].strip():
                    raise ConfigError('Route requires an explicit model (use exact-cosine for local search)')
                if 'modes' in entry and (capability != 'video' or not isinstance(entry['modes'], list) or not entry['modes'] or any(m not in ('understand', 'generate') for m in entry['modes'])):
                    raise ConfigError('Route modes is only for video: understand/generate')
                if 'revision' in entry and not isinstance(entry['revision'], str):
                    raise ConfigError('Route revision must be a string')
            clean[capability] = entries
        values['routes'] = clean
        permissions = values.get('permissions', list(PERMISSIONS))
        if not isinstance(permissions, list) or any(not isinstance(p, str) or p not in PERMISSIONS for p in permissions):
            raise ConfigError('Invalid capability permissions')
        values['permissions'] = tuple(permissions)
        if 'reasoning' in clean:
            route = clean['reasoning'][0]
            provider = providers[route['provider']]
            values.setdefault('provider', provider['adapter'])
            values.setdefault('model', route['model'])
            for key in ('base_url', 'api_key', 'api_key_env', 'timeout'):
                if key in provider:
                    values.setdefault(key, provider[key])
        normalized[name] = values
    return normalized, providers

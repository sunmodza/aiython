import math
from typing import TypedDict


class Params(TypedDict):
    learning_rate: float
    max_depth: int
    dropout: float


history: list[dict] = []

search_space = {
    "learning_rate": [0.001, 0.3],
    "max_depth": [2, 16],
    "dropout": [0.0, 0.6],
}


def evaluate(p: Params) -> float:
    lr = p["learning_rate"]
    depth = p["max_depth"]
    dropout = p["dropout"]

    score = 0.94

    # learning-rate landscape
    score -= 0.055 * (math.log10(lr) - math.log10(0.03)) ** 2

    # depth
    score -= 0.004 * (depth - 7) ** 2

    # dropout
    score -= 0.30 * (dropout - 0.18) ** 2

    # make the landscape slightly annoying / non-smooth
    score += 0.008 * math.sin(depth * 1.7)
    score += 0.005 * math.sin(math.log(lr) * 4)

    return score


for trial in range(1, 11):


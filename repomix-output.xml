import os
import tempfile
import unittest
from pathlib import Path
from unittest.mock import patch

from aithon.config import credential, describe, resolve
from aithon.models import ConfigError


class ConfigTests(unittest.TestCase):
    def test_direct_api_key_and_environment_fallback(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            path = root / "aithon.toml"
            source = ('version=1\ndefault_profile="default"\n[profiles.default]\n'
                      'provider="openai-compatible"\nmodel="test"\n'
                      'base_url="https://openrouter.ai/api/v1"\n'
                      'api_key="direct-test-key"\napi_key_env="TEST_AI_KEY"\n')
            path.write_text(source)
            with patch.dict(os.environ, {"TEST_AI_KEY": "environment-test-key"}):
                config = resolve(root / "main.py")
                self.assertEqual(credential(config, config.profiles["default"]), "direct-test-key")
                self.assertNotIn("direct-test-key", repr(config))
                self.assertNotIn("direct-test-key", str(describe(config)))
                path.write_text(source.replace('api_key="direct-test-key"', 'api_key=""'))
                config = resolve(root / "main.py")
                self.assertEqual(credential(config, config.profiles["default"]), "environment-test-key")

    def test_misconfigured_provider_and_key_have_safe_actionable_errors(self):
        cases = [
            ('provider="https://openrouter.ai/api/v1/"\nmodel="test"', "base_url", "https://openrouter.ai/api/v1/"),
            ('provider="openai-compatible"\nmodel="test"\napi_key_env="INVALID_KEY_NAME"', "environment variable name", "INVALID_KEY_NAME"),
        ]
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            for fields, expected, hidden in cases:
                with self.subTest(expected=expected):
                    (root / "aithon.toml").write_text('version=1\ndefault_profile="default"\n[profiles.default]\n' + fields)
                    with self.assertRaises(ConfigError) as caught:
                        resolve(root / "main.py")
                    self.assertIn(expected, str(caught.exception))
                    self.assertNotIn(hidden, str(caught.exception))

    def test_project_isolation_global_fallback_and_env(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            global_file = root / "global.toml"
            global_file.write_text('version=1\ndefault_profile="global"\n[profiles.global]\nprovider="fake"\nmodel="global-model"')
            for name in ("one", "two"):
                project = root / name
                project.mkdir()
                (project / ".git").mkdir()
                (project / "nested").mkdir()
                (project / "aithon.toml").write_text(f'version=1\ndefault_profile="fast"\nenv_file=".env"\n[profiles.fast]\nprovider="fake"\nmodel="{name}"\napi_key_env="PROJECT_KEY"')
                (project / ".env").write_text(f'PROJECT_KEY="secret-{name}"')
            with patch("aithon.config.global_config_path", return_value=global_file):
                one = resolve(root / "one/nested/main.py")
                two = resolve(root / "two/main.py")
                self.assertEqual(one.profiles["fast"].model, "one")
                self.assertEqual(two.profiles["fast"].model, "two")
                self.assertNotIn("global", one.profiles)
                self.assertEqual(credential(one, one.profiles["fast"]), "secret-one")
                with patch.dict(os.environ, {"PROJECT_KEY": "process-secret"}):
                    self.assertEqual(credential(one, one.profiles["fast"]), "process-secret")
                self.assertNotIn("secret-one", str(describe(one)))
                self.assertNotIn("secret-one", repr(one))
                self.assertEqual(resolve(root / "main.py").default_profile, "global")

    def test_bad_project_does_not_fallback(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            (root / "aithon.toml").write_text("invalid config")
            with self.assertRaises(ConfigError):
                resolve(root / "main.py")

    def test_explicit_and_missing_config(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            path = root / "custom.toml"
            path.write_text('version=1\n[profiles.only]\nprovider="fake"\nmodel="test"')
            config = resolve(root / "main.py", config_path=str(path), profile="only")
            self.assertEqual(config.cli_profile, "only")
            with self.assertRaises(ConfigError):
                resolve(root / "main.py", config_path=str(root / "missing.toml"))
            with self.assertRaises(ConfigError):
                resolve(root / "main.py", profile="a", force_profile="b")

    def test_http_errors_redact_and_classify_acceptance(self):
        import urllib.error
        http = HTTP('https://example.test/v1','SECRET_SENTINEL')
        for code, retryable, accepted in [(429,True,False),(503,False,True),(400,False,False)]:

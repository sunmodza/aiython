"""Native REST adapters. No credentials or remote error bodies enter diagnostics."""
from __future__ import annotations

import base64
from dataclasses import replace
import io
import importlib.metadata
import json
import mimetypes
from pathlib import Path
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
import wave

from .assets import Asset, Audio, Image, Video
from .capabilities import (CapabilityError, CapabilityRequest, CapabilityResult, Embeddings,
                           InvocationError, LocalProvider, canonical)
from .config import credential
from .models import ConfigError, ProfileConfig
from .providers import NoRedirect, OpenAICompatible, parse_completion
from .stats import record_request_bytes, record_token_usage
from .prompt_cache import chat_body


class HTTP:
    def __init__(self, base_url, key, *, gemini=False, timeout=60):
        parsed = urllib.parse.urlsplit(base_url)
        if parsed.scheme not in ('http', 'https') or not parsed.netloc or parsed.username or parsed.password or parsed.query or parsed.fragment:
            raise ConfigError('Provider base_url must be HTTP(S) without embedded credentials/query/fragment')
        self.base = base_url.rstrip('/')
        self.origin = (parsed.scheme, parsed.netloc)
        self.key = key
        self.gemini = gemini
        self.timeout = timeout
        self.opener = urllib.request.build_opener(NoRedirect())

    def request(self, path, body=None, *, method=None, headers=None, binary=False, response_headers=False):
        url = path if path.startswith(('http://', 'https://')) else self.base + '/' + path.lstrip('/')
        parsed = urllib.parse.urlsplit(url)
        if (parsed.scheme, parsed.netloc) != self.origin:
            raise InvocationError('Provider returned an untrusted URL')
        data = body if isinstance(body, bytes) else (canonical(body).encode() if body is not None else None)
        hdr = {'Content-Type': 'application/json'}
        if self.key:
            hdr['x-goog-api-key' if self.gemini else 'Authorization'] = self.key if self.gemini else 'Bearer ' + self.key
        hdr.update(headers or {})
        if data is not None:
            record_request_bytes(len(data))
        verb = method or ('POST' if data is not None else 'GET')
        request = urllib.request.Request(url, data=data, headers=hdr, method=verb)
        try:
            with self.opener.open(request, timeout=self.timeout) as response:
                raw = response.read()
                value = raw if binary else (json.loads(raw) if raw else {})
                return (value, dict(response.headers)) if response_headers else value
        except urllib.error.HTTPError as exc:
            code = exc.code
            exc.close()
            # A 429 explicitly rejects the request. 5xx/connection failures may
            # occur after acceptance, so never retry a generation on ambiguity.
            raise InvocationError(f'Provider HTTP {code}', retryable=code == 429,
                                  accepted=code >= 500) from None
        except (urllib.error.URLError, TimeoutError, OSError):
            raise InvocationError('Provider connection failed; acceptance is unknown', accepted=verb == 'POST') from None
        except (ValueError, TypeError):
            raise InvocationError('Invalid provider JSON response', accepted=verb == 'POST') from None

    def download(self, url):
        """Follow media GET redirects, never forward the API key across origins."""
        for _ in range(5):
            parsed = urllib.parse.urlsplit(url)
            same = (parsed.scheme, parsed.netloc) == self.origin
            google_media = parsed.scheme == 'https' and (parsed.hostname == 'storage.googleapis.com' or
                (parsed.hostname or '').endswith('.googleusercontent.com'))
            if parsed.username or parsed.password or not (same or self.gemini and google_media):
                raise InvocationError('Untrusted media download URL', accepted=True)
            headers = {}
            if same and self.key:
                headers['x-goog-api-key' if self.gemini else 'Authorization'] = self.key if self.gemini else 'Bearer ' + self.key
            try:
                with self.opener.open(urllib.request.Request(url, headers=headers), timeout=self.timeout) as response:
                    return response.read()
            except urllib.error.HTTPError as exc:
                location = exc.headers.get('Location') if exc.headers else None
                code = exc.code
                exc.close()
                if code in (301,302,303,307,308) and location:
                    url = urllib.parse.urljoin(url, location)
                    continue
                raise InvocationError(f'Media download HTTP {code}', accepted=True) from None
            except (urllib.error.URLError, TimeoutError, OSError):
                raise InvocationError('Media download failed; resume the existing job', accepted=True) from None
        raise InvocationError('Too many media download redirects', accepted=True)


def text_of(document):
    if isinstance(document, str): return document
    if isinstance(document, dict) and isinstance(document.get('text'), str): return document['text']
    raise CapabilityError('Expected text or a document/search hit containing text')


def public_context(value):
    """Only explicit text/source fields cross the boundary; never repr live objects."""
    if type(value) is dict:
        return {k: public_context(v) for k,v in value.items() if k != 'object'}
    if type(value) in (list, tuple): return [public_context(v) for v in value]
    if value is None or type(value) in (str, int, float, bool): return value
    raise CapabilityError('Reasoning context must contain text or JSON records')


class OpenRouterAdapter:
    version = '1'

    def __init__(self, http):
        self.http = http

    def capabilities(self):
        return {'reasoning', 'embedding', 'reranking'}

    def invoke(self, request, context):
        p, cap = request.params, request.capability
        try:
            if cap == 'embedding':
                inputs = p['inputs']
                if not isinstance(inputs, list) or not inputs:
                    raise CapabilityError('inputs must be a nonempty list')
                body = {'model': request.model, 'input': [text_of(x) for x in inputs]}
                for key in ('dimensions', 'task_type'):
                    if key in p: body[key] = p[key]
                response = self.http.request('embeddings', body)
                rows = sorted(response['data'], key=lambda r: r['index'])
                if [r['index'] for r in rows] != list(range(len(inputs))):
                    raise ValueError('Embedding count/index mismatch')
                space = canonical({'provider': self.http.base, 'model': request.model, 'revision': request.revision,
                                   'dimensions': len(rows[0]['embedding'])})
                value = Embeddings([r['embedding'] for r in rows], space)
            elif cap == 'reranking':
                documents = p['documents']
                response = self.http.request('rerank', {'model': request.model, 'query': p['query'],
                    'documents': [text_of(d) for d in documents], 'top_n': p.get('limit', len(documents))})
                rows = response['results']
                indices = [r['index'] for r in rows]
                if any(type(i) is not int or i < 0 or i >= len(documents) for i in indices) or len(set(indices)) != len(indices):
                    raise ValueError('Invalid rerank indices')
                value = [documents[i] for i in indices]
            elif cap == 'reasoning':
                prompt = p['prompt']
                if 'context' in p:
                    prompt += '\nContext (cite source fields):\n' + canonical(public_context(p['context']))
                response = self.http.request('chat/completions', {'model': request.model,
                    'messages': [{'role': 'user', 'content': prompt}]})
                value = response['choices'][0]['message']['content']
                if not isinstance(value, str): raise ValueError('Missing text')
            else:
                raise CapabilityError('Unsupported OpenRouter capability')
            return CapabilityResult(value, response.get('usage', {}))
        except (KeyError, IndexError, TypeError, ValueError):
            raise InvocationError('Malformed capability response', accepted=True) from None


class LegacyAdapter:
    version = '1'
    def __init__(self, provider): self.provider = provider
    def capabilities(self): return {'reasoning'}
    def invoke(self, request, context):
        prompt = request.params['prompt']
        if 'context' in request.params:
            prompt += '\n' + canonical(public_context(request.params['context']))
        result = self.provider.complete([{'role': 'user', 'content': prompt}], [])
        value = result.get('content')
        if not isinstance(value, str): raise InvocationError('Reasoning provider returned no text', accepted=True)
        return CapabilityResult(value)


class GeminiAdapter:
    version = '1'
    def __init__(self, http):
        self.http = http
        self.uploads = {}

    def capabilities(self):
        return {'reasoning', 'vision', 'document_understanding', 'embedding', 'speech_to_text',
                'text_to_speech', 'image_generation', 'image_editing', 'video'}

    def part(self, asset):
        if not isinstance(asset, Asset): return {'text': text_of(asset)}
        mime = asset.mime_type
        digest = asset.content_hash()
        cached = self.uploads.get(digest)
        if cached and cached[0] > time.time(): return cached[1]
        if asset.path.stat().st_size <= 10 * 1024 * 1024:
            return {'inlineData': {'mimeType': mime, 'data': base64.b64encode(asset.path.read_bytes()).decode()}}
        # Large assets use resumable uploads, without entering planner context.
        origin = urllib.parse.urlunsplit((*self.http.origin, '', '', ''))
        _, headers = self.http.request(origin + '/upload/v1beta/files',
            {'file': {'display_name': asset.path.name}}, headers={
                'X-Goog-Upload-Protocol': 'resumable', 'X-Goog-Upload-Command': 'start',
                'X-Goog-Upload-Header-Content-Length': str(asset.path.stat().st_size),
                'X-Goog-Upload-Header-Content-Type': mime}, response_headers=True)
        upload_url = {k.lower():v for k,v in headers.items()}.get('x-goog-upload-url')
        if not upload_url: raise InvocationError('Missing resumable upload URL')
        response = self.http.request(upload_url, asset.path.read_bytes(), headers={
            'Content-Type': mime, 'X-Goog-Upload-Offset': '0', 'X-Goog-Upload-Command': 'upload, finalize'})
        file = response['file']
        deadline = time.monotonic() + self.http.timeout
        while file.get('state') == 'PROCESSING':
            if time.monotonic() >= deadline: raise InvocationError('Asset processing timed out')
            time.sleep(2)
            file = self.http.request(file['name'])
        if file.get('state') == 'FAILED': raise InvocationError('Asset processing failed')
        part = {'fileData': {'mimeType': mime, 'fileUri': file['uri']}}
        self.uploads[digest] = (time.time() + 3600, part)
        return part

    def artifact(self, context, data, mime, cls):
        extension = mimetypes.guess_extension(mime.split(';')[0]) or '.bin'
        if cls is Audio and (mime.startswith('audio/L16') or mime.startswith('audio/pcm')):
            buffer = io.BytesIO()
            with wave.open(buffer, 'wb') as file:
                file.setnchannels(1); file.setsampwidth(2); file.setframerate(24000); file.writeframes(data)
            data, mime, extension = buffer.getvalue(), 'audio/wav', '.wav'
        folder = context.store.root / 'artifacts'
        folder.mkdir(parents=True, exist_ok=True)
        path = folder / (uuid.uuid4().hex + extension)
        with path.open('xb') as file: file.write(data)
        return cls(path, mime)

    def wait_video(self, name, context):
        record = context.store.job(name)
        if not record: raise CapabilityError('Unknown video job')
        if record.get('artifact'):
            path = Path(record['artifact'])
            if path.is_file(): return Video(path, 'video/mp4')
        deadline = time.monotonic() + max(self.http.timeout, 600)
        try:
            while True:
                response = self.http.request(name)
                if response.get('done'):
                    if 'error' in response:
                        context.store.job(name, {**record, 'status': 'failed'})
                        raise InvocationError('Video job failed', accepted=True)
                    uri = response['response']['generateVideoResponse']['generatedSamples'][0]['video']['uri']
                    data = self.http.download(uri)
                    artifact = self.artifact(context, data, 'video/mp4', Video)
                    context.store.job(name, {**record, 'status': 'complete', 'artifact': str(artifact.path)})
                    return artifact
                if time.monotonic() >= deadline:
                    raise InvocationError(f'Video job still pending; resume operation {name}', accepted=True)
                time.sleep(5)
        except KeyboardInterrupt:
            try:
                self.http.request(name + ':cancel', {})
                status = 'cancellation_requested'
            except InvocationError:
                status = 'pending'
            context.store.job(name, {**record, 'status': status})
            raise

    def invoke(self, request, context):
        p, cap = request.params, request.capability
        model = urllib.parse.quote(request.model.removeprefix('models/'), safe='-._')
        try:
            if cap == 'video' and p['mode'] == 'generate':
                instance = {'prompt': p['prompt']}
                if p.get('assets'):
                    if len(p['assets']) != 1: raise CapabilityError('Video generation accepts one starting image')
                    image = p['assets'][0]
                    instance['image'] = {'bytesBase64Encoded': base64.b64encode(image.path.read_bytes()).decode(), 'mimeType': image.mime_type}
                operation = self.http.request(f'models/{model}:predictLongRunning', {'instances': [instance]})
                name = operation['name']
                context.store.job(name, {'status': 'pending', 'model': request.model, 'provider': request.provider, 'provider_url': self.http.base})
                try:
                    return CapabilityResult(self.wait_video(name, context))
                except InvocationError as exc:
                    # Poll/download failures occur AFTER successful submission.
                    raise InvocationError(str(exc), accepted=True) from None
            if cap == 'embedding':
                vectors = []
                for item in p['inputs']:
                    body = {'model': 'models/' + request.model.removeprefix('models/'), 'content': {'parts': [self.part(item)]}}
                    if 'dimensions' in p: body['outputDimensionality'] = p['dimensions']
                    if 'task_type' in p: body['taskType'] = p['task_type']
                    response = self.http.request(f'models/{model}:embedContent', body)
                    vectors.append(response['embedding']['values'])
                space = canonical({'provider': self.http.base, 'model': request.model, 'revision': request.revision,
                                   'dimensions': len(vectors[0])})
                return CapabilityResult(Embeddings(vectors, space))
            prompt = p.get('prompt', p.get('text', ''))
            if cap == 'speech_to_text': prompt = 'Transcribe verbatim, retaining the original language. ' + prompt
            extracting = cap == 'document_understanding' and not prompt
            if extracting: prompt = 'Extract the document content as chunks. Return text, zero-based asset_index in the supplied file order, and one-based page number for each chunk.'
            if 'context' in p: prompt += '\n' + canonical(public_context(p['context']))
            if cap == 'text_to_speech':
                response = self.http.request('interactions', {'model': request.model, 'input': p['text'],
                    'response_format': {'type': 'audio'}, 'generation_config': {'speech_config': [{'voice': p.get('voice', 'Kore')}]}})
                audio = response.get('output_audio')
                if audio is None:
                    content = [part for step in response.get('steps', []) if step.get('type') == 'model_output'
                               for part in step.get('content', [])]
                    content += response.get('outputs', [])
                    audio = next(o for o in reversed(content) if o.get('type') == 'audio')
                return CapabilityResult(self.artifact(context, base64.b64decode(audio['data'], validate=True),
                    audio.get('mime_type', 'audio/pcm'), Audio), response.get('usage', {}))
            parts = [{'text': prompt}] + [self.part(a) for a in p.get('assets', [])]
            body = {'contents': [{'role': 'user', 'parts': parts}]}
            if extracting:
                body['generationConfig'] = {'responseMimeType': 'application/json', 'responseSchema': {
                    'type': 'ARRAY', 'items': {'type': 'OBJECT', 'properties': {
                        'text': {'type': 'STRING'}, 'asset_index': {'type': 'INTEGER'}, 'page': {'type': 'INTEGER'}},
                        'required': ['text', 'asset_index', 'page']}}}
            if cap in ('image_generation', 'image_editing'):
                body['generationConfig'] = {'responseModalities': ['TEXT', 'IMAGE']}
            response = self.http.request(f'models/{model}:generateContent', body)
            parts = response['candidates'][0]['content']['parts']
            if cap in ('image_generation', 'image_editing'):
                media = next(part['inlineData'] for part in parts if 'inlineData' in part)
                value = self.artifact(context, base64.b64decode(media['data'], validate=True), media['mimeType'], Image)
            else:
                value = '\n'.join(part['text'] for part in parts if 'text' in part and not part.get('thought'))
                if not value: raise ValueError('No text response')
                if extracting:
                    chunks = json.loads(value)
                    if not isinstance(chunks, list) or not chunks: raise ValueError('No document chunks')
                    value = []
                    for chunk in chunks:
                        index, page = chunk['asset_index'], chunk['page']
                        if type(index) is not int or not 0 <= index < len(p['assets']) or type(page) is not int or page < 1 or not isinstance(chunk['text'], str):
                            raise ValueError('Invalid document location')
                        value.append({'text': chunk['text'], 'source': f'{p["assets"][index].path}:page {page}'})
            return CapabilityResult(value, response.get('usageMetadata', {}))
        except (KeyError, IndexError, TypeError, ValueError, StopIteration):
            raise InvocationError('Malformed Gemini capability response', accepted=True) from None


def provider_profile(config, profile, name, model=None):
    if name == '$legacy': return profile
    values = dict(config.providers[name])
    adapter = values.pop('adapter')
    defaults = {'openrouter': 'https://openrouter.ai/api/v1', 'gemini': 'https://generativelanguage.googleapis.com/v1beta'}
    values.setdefault('base_url', defaults.get(adapter, 'https://api.openai.com/v1'))
    return ProfileConfig(name=name, provider=adapter, model=model or profile.model, **values)


def make_adapter(config, profile, name):
    selected = provider_profile(config, profile, name)
    if selected.provider == 'local': return LocalProvider()
    key = credential(config, selected)
    if selected.api_key_env and not key:
        raise ConfigError(f'Provider {selected.name!r}: configured credential is missing')
    if selected.provider in ('openrouter', 'gemini'):
        if not key:
            raise ConfigError(f'Provider {selected.name!r} requires api_key or api_key_env')
        http = HTTP(selected.base_url, key, gemini=selected.provider == 'gemini', timeout=selected.timeout)
        return GeminiAdapter(http) if selected.provider == 'gemini' else OpenRouterAdapter(http)
    if selected.provider == 'openai-compatible':
        return LegacyAdapter(OpenAICompatible(selected, key))
    entries = list(importlib.metadata.entry_points(group='aithon.providers', name=selected.provider))
    if len(entries) != 1: raise ConfigError('Provider requires exactly one installed entry point')
    adapter = entries[0].load()(profile=selected, api_key=key)
    if callable(getattr(adapter, 'invoke', None)) and callable(getattr(adapter, 'capabilities', None)):
        return adapter
    return LegacyAdapter(adapter)


class RoutedReasoning:
    """Keep the existing chat/tool protocol while applying ordered reasoning routes."""
    def __init__(self, config, profile):
        self.config, self.profile = config, profile

    def complete(self, messages, tools):
        routes = self.profile.routes['reasoning']
        for i, route in enumerate(routes):
            selected = provider_profile(self.config, self.profile, route['provider'], route['model'])
            key = credential(self.config, selected)
            if (selected.api_key_env or selected.provider in ('openrouter', 'gemini')) and not key:
                raise ConfigError('Reasoning provider requires api_key or api_key_env')
            if selected.provider not in ('gemini', 'openrouter', 'openai-compatible'):
                from .providers import load_provider
                return load_provider(self.config, selected).complete(messages, tools)
            if selected.provider == 'gemini':
                # Gemini exposes an OpenAI-compatible tool protocol endpoint.
                selected = replace(selected, base_url=selected.base_url.rstrip('/') + '/openai', provider='openai-compatible')
            http = HTTP(selected.base_url, key, timeout=selected.timeout)
            try:
                result = http.request('chat/completions', chat_body(selected, messages, tools))
                return parse_completion(result, selected)
            except InvocationError as exc:
                if exc.retryable and not exc.accepted and i + 1 < len(routes): continue
                raise
            except (KeyError, IndexError, TypeError):
                raise InvocationError('Malformed reasoning response', accepted=True) from None

from __future__ import annotations

import json
import math
import os
import re
import sys
import tomllib
from pathlib import Path

from .models import ConfigError, ProfileConfig, ResolvedConfig


def global_config_path() -> Path:
    if sys.platform == "win32":
        root = Path(os.environ.get("APPDATA", Path.home() / "AppData/Roaming"))
    elif sys.platform == "darwin":
        root = Path.home() / "Library/Application Support"
    else:
        root = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return root / "aithon" / "config.toml"


def discover(start: Path) -> Path | None:
    for directory in (start, *start.parents):
        candidate = directory / "aithon.toml"
        if candidate.is_file():
            return candidate
        if (directory / ".git").exists():
            break
    return None


def read_env(path: Path) -> dict[str, str]:
    """Small literal KEY=VALUE format: no execution or variable interpolation."""
    result = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise ConfigError(f"Cannot read env_file: {path}") from exc
    for number, line in enumerate(lines, 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.removeprefix("export ").partition("=")
        key, value = key.strip(), value.strip()
        if not separator or not key.isidentifier():
            raise ConfigError(f"Invalid environment assignment at {path}:{number}")
        if value.startswith('"'):
            try:
                value = json.loads(value)
            except ValueError:
                raise ConfigError(f"Invalid quoted value at {path}:{number}") from None
        elif value.startswith("'"):
            if len(value) < 2 or not value.endswith("'"):
                raise ConfigError(f"Invalid quoted value at {path}:{number}")
            value = value[1:-1]
        result[key] = value
    return result


def resolve(script: Path, *, config_path: str | None = None,
            profile: str | None = None, force_profile: str | None = None) -> ResolvedConfig:
    script = script.resolve()
    if profile and force_profile:
        raise ConfigError("Use either --profile or --force-profile, not both")
    project_path = Path(config_path).resolve() if config_path else discover(script.parent)
    path = project_path
    if path is None and global_config_path().is_file():
        path = global_config_path()
    root = project_path.parent if project_path else script.parent
    if path is None:
        return ResolvedConfig(None, root, cli_profile=profile, force_profile=force_profile)
    try:
        data = tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise ConfigError(f"Cannot read Aithon config: {path} ({type(exc).__name__})") from None
    unknown = data.keys() - {"version", "default_profile", "profiles", "env_file", "providers"}
    if unknown:
        raise ConfigError(f"Unknown config fields: {', '.join(sorted(unknown))}")
    if type(data.get("version")) is not int or data["version"] not in (1, 2):
        raise ConfigError("aithon.toml requires version = 1 or 2")
    profiles = {}
    providers = {}
    raw_profiles = data.get("profiles", {})
    if data["version"] == 2:
        from .capability_config import normalize_v2
        raw_profiles, providers = normalize_v2(data)
    elif "providers" in data:
        raise ConfigError("Named providers require version = 2")
    if not isinstance(raw_profiles, dict):
        raise ConfigError("profiles must be a table")
    fields = {"provider", "model", "base_url", "api_key", "api_key_env", "prompt", "timeout", "max_rounds", "tool_choice"}
    if data["version"] == 2:
        fields |= {"routes", "permissions"}
    for name, values in raw_profiles.items():
        if not name.strip():
            raise ConfigError("Profile names must not be empty")
        if not isinstance(values, dict) or values.keys() - fields:
            raise ConfigError(f"Invalid fields in profile {name!r}; use api_key or api_key_env for credentials")
        for required in ("provider", "model"):
            if not isinstance(values.get(required), str) or not values[required].strip():
                raise ConfigError(f"Profile {name!r} requires {required}")
        for key in ("base_url", "api_key", "api_key_env", "prompt"):
            if key in values and not isinstance(values[key], str):
                raise ConfigError(f"Profile {name!r}: {key} must be a string")
        if values["provider"].startswith(("https://", "http://")):
            raise ConfigError(
                f"Profile {name!r}: provider must be an adapter name, not a URL; "
                'use provider = "openai-compatible" and put the URL in base_url')
        if "api_key_env" in values and not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", values["api_key_env"]):
            raise ConfigError(
                f"Profile {name!r}: api_key_env must be an environment variable name "
                '(for example "OPENROUTER_API_KEY"); use api_key to paste the key directly')
        for key in ("timeout", "max_rounds"):
            value = values.get(key, 1)
            if type(value) not in (int, float) or not math.isfinite(value) or value <= 0:
                raise ConfigError(f"Profile {name!r}: {key} must be positive")
        if "max_rounds" in values and type(values["max_rounds"]) is not int:
            raise ConfigError("max_rounds must be an integer")
        if values.get("tool_choice", "required") not in ("required", "auto"):
            raise ConfigError("tool_choice must be required or auto")
        profiles[name] = ProfileConfig(name=name, **values)
    default = data.get("default_profile")
    if default is not None and (not isinstance(default, str) or default not in profiles):
        raise ConfigError("default_profile must name a profile defined in this config")
    secrets = {}
    if "env_file" in data:
        if not isinstance(data["env_file"], str):
            raise ConfigError("env_file must be a path string")
        secrets = read_env(path.parent / data["env_file"])
    return ResolvedConfig(path, root, default, profiles, secrets, profile, force_profile, providers)


def credential(config: ResolvedConfig, profile: ProfileConfig) -> str | None:
    if profile.api_key:
        return profile.api_key
    if not profile.api_key_env:
        return None
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", profile.api_key_env):
        raise ConfigError("api_key_env must be an environment variable name, not the API key itself")
    return os.environ.get(profile.api_key_env, config.secrets.get(profile.api_key_env))


def describe(config: ResolvedConfig) -> dict:
    return {
        "config": str(config.path) if config.path else None,
        "project_root": str(config.project_root),
        "default_profile": config.force_profile or config.cli_profile or config.default_profile,
        "profiles": {
            name: {"provider": p.provider, "model": p.model,
                   "credential_configured": bool(credential(config, p)),
                   "routes": p.routes, "permissions": p.permissions}
            for name, p in config.profiles.items()
        },
    }

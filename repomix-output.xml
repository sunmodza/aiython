<file path="examples/project/main.py">
# main.py

from datetime import datetime, timedelta
from typing import Annotated, Literal, TypedDict, get_args


Category = Literal["availability", "performance", "security", "billing", "feature_request", "other"]
Severity = Literal["critical", "high", "medium", "low"]


class TicketAnalysis(TypedDict):
    category: Category
    severity: Severity
    summary: Annotated[str, "สรุปปัญหาภาษาไทยไม่เกิน 1 ประโยค"]
    reason: Annotated[str, "เหตุผลสั้น ๆ ว่าทำไมถึงเลือกระดับนี้"]
    recommended_team: Annotated[str, "ทีมที่ควรรับเรื่อง เช่น Platform, Security, Payments, Product"]


# ============================================================
# Input จากระบบ ticket จริง
# ============================================================

tickets = [
    {
        "id": "INC-1001",
        "customer": "ร้าน ABC",
        "plan": "enterprise",
        "message": """
        ตั้งแต่ประมาณ 10 โมง ลูกค้าของเรากด checkout แล้วจ่ายไม่ได้
        ลองทั้งบัตรเครดิตกับ QR ก็เป็นเหมือนกัน
        ตอนนี้มีลูกค้าทักมาประมาณ 40 คนแล้ว
        """,
        "created_at": datetime(2026, 9, 22, 10, 5),
    },
    {
        "id": "INC-1002",
        "customer": "บริษัท XYZ",
        "plan": "pro",
        "message": """
        dashboard วันนี้รู้สึกโหลดช้ากว่าปกติ
        ปกติประมาณ 1 วิ วันนี้ประมาณ 4-5 วิ
        แต่ยังใช้งานได้
        """,
        "created_at": datetime(2026, 9, 22, 10, 20),
    },
    {
        "id": "INC-1003",
        "customer": "Startup Foo",
        "plan": "pro",
        "message": """
        เมื่อคืนมีแจ้งเตือน login จาก IP ประเทศที่ทีมเราไม่มีใครอยู่
        และมีการสร้าง API key ใหม่หนึ่งตัว
        ตอนนี้ยังไม่แน่ใจว่า account โดนเข้าถึงหรือเปล่า
        """,
        "created_at": datetime(2026, 9, 22, 10, 35),
    },
    {
        "id": "REQ-1004",
        "customer": "ร้าน Bar",
        "plan": "free",
        "message": """
        อยากให้หน้า report มี dark mode ครับ
        เปิดทำงานกลางคืนแล้วแสบตา
        """,
        "created_at": datetime(2026, 9, 22, 11, 0),
    },
]


# ============================================================
# ส่วน deterministic
# ============================================================

VALID_SEVERITIES = set(get_args(Severity))

SLA_MINUTES = {
    "critical": 15,
    "high": 60,
    "medium": 240,
    "low": 1440,
}


def calculate_deadline(created_at: datetime, severity: Severity) -> datetime:
    return created_at + timedelta(minutes=SLA_MINUTES[severity])



# ============================================================
# AI ทำเฉพาะส่วนที่ semantic / fuzzy
# ============================================================

processed_tickets = []

for ticket in tickets:

    print(f"\nAnalyzing {ticket['id']} ...")

    # context ของ ticket ปัจจุบันอยู่ใน live Python runtime

    # aithon: prompt="คุณกำลังช่วย triage incident ของ SaaS production system"
    # aithon: prompt="อย่าตัดสิน severity จากคำที่ฟังดูน่ากลัวอย่างเดียว ให้ดูผลกระทบที่ระบุจริง"
    # aithon: prompt="security incident ที่อาจมี credential compromise ให้ระมัดระวังเป็นพิเศษ"

    analysis: TicketAnalysis = วิเคราะห์ ticket ปัจจุบันจาก ticket["message"]

    # --------------------------------------------------------
    # กลับเข้าสู่ deterministic Python ทันที
    # --------------------------------------------------------

    deadline = calculate_deadline(
        ticket["created_at"],
        analysis["severity"],
    )

    processed = {
        **ticket,
        **analysis,
        "sla_deadline": deadline,
    }

    processed_tickets.append(processed)


# ============================================================
# Business rule ที่ชัดเจน ไม่ควรให้ AI ตัดสิน
# ============================================================

severity_priority = {
    "critical": 0,
    "high": 1,
    "medium": 2,
    "low": 3,
}

processed_tickets.sort(
    key=lambda x: (
        severity_priority[x["severity"]],
        x["created_at"],
    )
)


# ============================================================
# แสดง incident queue
# ============================================================

print("\n")
print("=" * 80)
print("INCIDENT QUEUE")
print("=" * 80)

for incident in processed_tickets:
    print(
        f"[{incident['severity'].upper():8}] "
        f"{incident['id']} | "
        f"{incident['recommended_team']:10} | "
        f"{incident['summary']}"
    )

    print(
        " " * 11,
        "SLA:",
        incident["sla_deadline"].strftime("%H:%M"),
    )



from __future__ import annotations

import importlib.metadata
import json
import urllib.error
import urllib.parse
import urllib.request

from .config import credential
from .models import ConfigError, ProfileConfig, ProviderError, ResolvedConfig
from .stats import CURRENT_STATS, record_request_bytes, record_token_usage
from .prompt_cache import chat_body


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def response_error(profile, reason, *, code=None):
    """Only local categories and integer remote codes enter diagnostics."""
    detail = {"reason": reason}
    if type(code) is int:
        detail['code'] = code
    stats = CURRENT_STATS.get()
    if stats is not None:
        stats.provider_errors.append(detail)
    suffix = f" (code {code})" if type(code) is int else ""
    raise ProviderError(f"Profile {profile.name!r}: {reason}{suffix}")


def parse_completion(result, profile):
    if not isinstance(result, dict):
        response_error(profile, 'response root must be an object')
    record_token_usage(result.get('usage'))
    if result.get('error') is not None:
        error = result['error']
        response_error(profile, 'provider returned an error envelope',
                       code=error.get('code') if isinstance(error, dict) else None)
    choices = result.get('choices')
    if not isinstance(choices, list) or not choices:
        response_error(profile, 'response has no completion choices')
    choice = choices[0]
    if not isinstance(choice, dict):
        response_error(profile, 'completion choice must be an object')
    reason = choice.get('finish_reason')
    if reason == 'length':
        response_error(profile, 'completion reached token limit; incomplete tool calls were not executed')
    if reason == 'content_filter':
        response_error(profile, 'provider filtered the completion')
    if reason == 'error' or choice.get('error') is not None:
        response_error(profile, 'provider reported a completion error')
    message = choice.get('message')
    if not isinstance(message, dict):
        response_error(profile, 'completion has no message object')
    if message.get('refusal'):
        response_error(profile, 'provider refused the request')
    calls = message.get('tool_calls')
    if calls is not None and not isinstance(calls, list):
        response_error(profile, 'message tool_calls must be an array')
    return {'role': 'assistant', 'content': message.get('content'),
            **({'tool_calls': calls} if calls else {})}


class OpenAICompatible:
    """Chat Completions + function tools. No SDK-global credentials or retries."""

    def __init__(self, profile: ProfileConfig, api_key: str | None):
        url = urllib.parse.urlsplit(profile.base_url)
        if url.scheme not in ("http", "https") or not url.netloc or url.username or url.password or url.query or url.fragment:
            raise ConfigError("base_url must be an HTTP(S) URL without embedded credentials, query or fragment")
        if url.hostname == "api.openai.com" and not api_key:
            raise ConfigError(f"Profile {profile.name!r} requires api_key or api_key_env")
        self.profile = profile
        self._api_key = api_key
        self._opener = urllib.request.build_opener(NoRedirect())

    def complete(self, messages: list[dict], tools: list[dict]) -> dict:
        body = json.dumps(chat_body(self.profile, messages, tools),
                          ensure_ascii=False, separators=(",", ":")).encode()
        record_request_bytes(len(body))
        headers = {"Content-Type": "application/json"}
        if self._api_key:
            headers["Authorization"] = f"Bearer {self._api_key}"
        request = urllib.request.Request(self.profile.base_url.rstrip("/") + "/chat/completions",
                                         data=body, headers=headers, method="POST")
        try:
            with self._opener.open(request, timeout=self.profile.timeout) as response:
                result = json.load(response)
            return parse_completion(result, self.profile)
        except urllib.error.HTTPError as exc:
            # Remote bodies may echo authentication or source. Never print them.
            exc.close()
            raise ProviderError(f"Profile {self.profile.name!r}: provider HTTP {exc.code}") from None
        except (urllib.error.URLError, TimeoutError, OSError) as exc:
            raise ProviderError(f"Profile {self.profile.name!r}: provider connection failed ({type(exc).__name__})") from None
        except (ValueError, UnicodeError):
            response_error(self.profile, 'provider returned invalid JSON')


def load_provider(config: ResolvedConfig, profile: ProfileConfig):
    if profile.routes.get("reasoning"):
        from .capability_providers import RoutedReasoning
        return RoutedReasoning(config, profile)
    key = credential(config, profile)
    if profile.api_key_env and not key:
        raise ConfigError(f"Profile {profile.name!r}: missing environment variable {profile.api_key_env}")
    if profile.provider == "openai-compatible":
        return OpenAICompatible(profile, key)
    matches = list(importlib.metadata.entry_points(group="aithon.providers", name=profile.provider))
    if len(matches) != 1:
        raise ConfigError(f"Provider {profile.provider!r} must have exactly one installed aithon.providers entry point")
    try:
        provider = matches[0].load()(profile=profile, api_key=key)
        if not callable(getattr(provider, "complete", None)):
            raise TypeError("Provider needs complete(messages, tools)")
        return provider
    except Exception:
        raise ProviderError(f"Cannot load provider {profile.provider!r}") from None

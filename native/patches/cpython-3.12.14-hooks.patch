diff --git a/Python/ceval.c b/Python/ceval.c
index 3985b52..d4ffda2 100644
--- a/Python/ceval.c
+++ b/Python/ceval.c
@@ -652,6 +652,122 @@ static inline void _Py_LeaveRecursiveCallPy(PyThreadState *tstate)  {
  * so consume 3 units of C stack */
 #define PY_EVAL_C_STACK_UNITS 2
 
+/* Experimental Aiython hook. The Python callback can raise to reject a store.
+   The guard prevents assignments inside that callback from calling it again. */
+static _Thread_local int aiython_in_hook = 0;
+
+static int
+aiython_before_store(_PyInterpreterFrame *frame, PyObject *name, PyObject *value)
+{
+    /* STORE_FAST_MAYBE_NULL may legally write an empty stack reference. */
+    if (value == NULL || aiython_in_hook) {
+        return 0;
+    }
+    PyObject *callback = NULL;
+    int found = _PySys_GetOptionalAttrString("_aiython_before_store", &callback);
+    if (found <= 0) {
+        return found < 0 ? -1 : 0;
+    }
+    PyFrameObject *borrowed = _PyFrame_GetFrameObject(frame);
+    if (borrowed == NULL) {
+        Py_DECREF(callback);
+        return -1;
+    }
+    PyObject *frame_obj = Py_NewRef(borrowed);
+    aiython_in_hook = 1;
+    PyObject *result = PyObject_CallFunctionObjArgs(callback, frame_obj, name, value, NULL);
+    aiython_in_hook = 0;
+    Py_DECREF(frame_obj);
+    Py_DECREF(callback);
+    if (result == NULL) {
+        return -1;
+    }
+    Py_DECREF(result);
+    return 0;
+}
+
+static int
+aiython_mutation_hook_enabled(void)
+{
+    return PySys_GetObject("_aiython_before_mutation") != NULL;
+}
+
+static int
+aiython_store_hook_enabled(void)
+{
+    return PySys_GetObject("_aiython_before_store") != NULL;
+}
+
+static int
+aiython_before_mutation(_PyInterpreterFrame *frame, const char *kind,
+                        PyObject *owner, PyObject *key, PyObject *value)
+{
+    if (aiython_in_hook) {
+        return 0;
+    }
+    PyObject *callback = NULL;
+    int found = _PySys_GetOptionalAttrString("_aiython_before_mutation", &callback);
+    if (found <= 0) {
+        return found < 0 ? -1 : 0;
+    }
+    PyFrameObject *borrowed = _PyFrame_GetFrameObject(frame);
+    if (borrowed == NULL) {
+        Py_DECREF(callback);
+        return -1;
+    }
+    PyObject *kind_obj = PyUnicode_FromString(kind);
+    if (kind_obj == NULL) {
+        Py_DECREF(callback);
+        return -1;
+    }
+    PyObject *frame_obj = Py_NewRef(borrowed);
+    aiython_in_hook = 1;
+    PyObject *result = PyObject_CallFunctionObjArgs(
+        callback, frame_obj, kind_obj, owner, key, value, NULL);
+    aiython_in_hook = 0;
+    Py_DECREF(frame_obj);
+    Py_DECREF(kind_obj);
+    Py_DECREF(callback);
+    if (result == NULL) {
+        return -1;
+    }
+    Py_DECREF(result);
+    return 0;
+}
+
+static int
+aiython_function_event(_PyInterpreterFrame *frame, const char *attribute,
+                       PyObject *value)
+{
+    if (aiython_in_hook) {
+        return 0;
+    }
+    PyObject *callback = NULL;
+    int found = _PySys_GetOptionalAttrString(attribute, &callback);
+    if (found <= 0) {
+        return found < 0 ? -1 : 0;
+    }
+    PyFrameObject *borrowed = _PyFrame_GetFrameObject(frame);
+    if (borrowed == NULL) {
+        Py_DECREF(callback);
+        return -1;
+    }
+    PyObject *frame_obj = Py_NewRef(borrowed);
+    aiython_in_hook = 1;
+    PyObject *result = value == NULL
+        ? PyObject_CallOneArg(callback, frame_obj)
+        : PyObject_CallFunctionObjArgs(callback, frame_obj, value, NULL);
+    aiython_in_hook = 0;
+    Py_DECREF(frame_obj);
+    Py_DECREF(callback);
+    if (result == NULL) {
+        return -1;
+    }
+    Py_DECREF(result);
+    return 0;
+}
+
+
 PyObject* _Py_HOT_FUNCTION
 _PyEval_EvalFrameDefault(PyThreadState *tstate, _PyInterpreterFrame *frame, int throwflag)
 {
